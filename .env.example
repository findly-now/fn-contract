# Confluent Cloud Kafka Configuration
# Copy this file to .env and fill in your actual credentials

# Schema Registry Configuration
SCHEMA_REGISTRY_URL=https://psrc-xxx.us-east-2.aws.confluent.cloud
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=api-key:api-secret

# Kafka Bootstrap Servers
KAFKA_BOOTSTRAP_SERVERS=pkc-xxx.us-east-2.aws.confluent.cloud:9092

# Authentication
KAFKA_SASL_USERNAME=api-key
KAFKA_SASL_PASSWORD=api-secret
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SECURITY_PROTOCOL=SASL_SSL

# Schema Registry Authentication
SCHEMA_REGISTRY_API_KEY=sr-api-key
SCHEMA_REGISTRY_API_SECRET=sr-api-secret

# Environment
ENVIRONMENT=development

# Optional: Schema Registry Subject Name Strategy
SCHEMA_REGISTRY_SUBJECT_NAME_STRATEGY=TopicNameStrategy

# Topic Configurations
POSTS_LIFECYCLE_TOPIC=posts.lifecycle
POSTS_MATCHING_TOPIC=posts.matching
USERS_LIFECYCLE_TOPIC=users.lifecycle
NOTIFICATIONS_DELIVERY_TOPIC=notifications.delivery
MEDIA_AI_ENRICHMENT_TOPIC=media-ai.enrichment

# Schema Validation Settings
VALIDATE_SCHEMAS_ON_STARTUP=true
AUTO_REGISTER_SCHEMAS=false
SCHEMA_COMPATIBILITY_LEVEL=BACKWARD