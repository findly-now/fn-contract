{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://findlynow.com/schemas/user-events.json",
  "title": "User Events Schema",
  "description": "Event schemas for user registration, organization management, and communication preferences",
  "definitions": {
    "BaseEvent": {
      "type": "object",
      "required": ["id", "event_type", "timestamp", "version"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique event identifier"
        },
        "event_type": {
          "type": "string",
          "description": "Type of event"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Event occurrence timestamp"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Event schema version"
        }
      }
    },
    "UserEvent": {
      "allOf": [
        { "$ref": "#/definitions/BaseEvent" },
        {
          "type": "object",
          "required": ["user_id", "data"],
          "properties": {
            "user_id": {
              "type": "string",
              "description": "User identifier"
            },
            "organization_id": {
              "type": "string",
              "format": "uuid",
              "description": "Organization identifier (for multi-tenant)",
              "nullable": true
            },
            "data": {
              "type": "object",
              "description": "Event-specific data"
            }
          }
        }
      ]
    }
  },
  "UserRegistered": {
    "allOf": [
      { "$ref": "#/definitions/UserEvent" },
      {
        "properties": {
          "event_type": {
            "const": "user.registered"
          },
          "data": {
            "type": "object",
            "required": ["user", "registration_source"],
            "properties": {
              "user": {
                "type": "object",
                "required": ["user_id", "display_name", "preferences"],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "description": "Unique user identifier"
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Privacy-safe display name (no PII)"
                  },
                  "avatar_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "User's avatar image URL",
                    "nullable": true
                  },
                  "preferences": {
                    "type": "object",
                    "required": ["timezone", "language", "notification_channels"],
                    "properties": {
                      "timezone": {
                        "type": "string",
                        "description": "User's timezone (IANA format)"
                      },
                      "language": {
                        "type": "string",
                        "enum": ["en", "es"],
                        "description": "Preferred language"
                      },
                      "notification_channels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["email", "sms", "whatsapp", "push"]
                        },
                        "description": "Enabled notification channels"
                      },
                      "notification_frequency": {
                        "type": "string",
                        "enum": ["immediate", "daily_digest", "weekly_digest"],
                        "default": "immediate",
                        "description": "Notification frequency preference"
                      },
                      "quiet_hours": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string",
                            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
                            "description": "Quiet hours start time (HH:MM)"
                          },
                          "end": {
                            "type": "string",
                            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
                            "description": "Quiet hours end time (HH:MM)"
                          }
                        },
                        "nullable": true
                      },
                      "categories": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["post_created", "post_matched", "post_claimed", "post_resolved", "system_updates"]
                        },
                        "description": "Notification categories opted into"
                      }
                    }
                  },
                  "organization_context": {
                    "type": "object",
                    "properties": {
                      "organization_id": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Organization identifier"
                      },
                      "organization_name": {
                        "type": "string",
                        "description": "Organization display name"
                      },
                      "role": {
                        "type": "string",
                        "enum": ["admin", "staff", "viewer"],
                        "description": "User role in organization"
                      },
                      "permissions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "User permissions"
                      }
                    },
                    "nullable": true,
                    "description": "Organization context if applicable"
                  }
                }
              },
              "registration_source": {
                "type": "string",
                "enum": ["web", "mobile", "api"],
                "description": "Source of registration"
              },
              "registration_metadata": {
                "type": "object",
                "properties": {
                  "ip_country": {
                    "type": "string",
                    "description": "Country derived from IP (for analytics)"
                  },
                  "user_agent": {
                    "type": "string",
                    "description": "User agent string (anonymized)"
                  },
                  "referrer": {
                    "type": "string",
                    "description": "Registration referrer source"
                  }
                },
                "description": "Registration metadata for analytics (no PII)"
              },
              "verification_status": {
                "type": "object",
                "properties": {
                  "email_verified": {
                    "type": "boolean",
                    "description": "Email verification status"
                  },
                  "phone_verified": {
                    "type": "boolean",
                    "description": "Phone verification status"
                  },
                  "verification_method": {
                    "type": "string",
                    "enum": ["email_link", "sms_code", "oauth", "admin_approval"],
                    "description": "Method used for verification"
                  }
                },
                "description": "Verification status without exposing contact details"
              }
            }
          }
        }
      }
    ]
  },
  "StaffAdded": {
    "allOf": [
      { "$ref": "#/definitions/UserEvent" },
      {
        "properties": {
          "event_type": {
            "const": "organization.staff_added"
          },
          "data": {
            "type": "object",
            "required": ["staff_user", "organization_context", "added_by_user"],
            "properties": {
              "staff_user": {
                "type": "object",
                "required": ["user_id", "display_name", "preferences"],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "description": "Staff member user ID"
                  },
                  "display_name": {
                    "type": "string",
                    "description": "Staff member display name"
                  },
                  "avatar_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true
                  },
                  "preferences": {
                    "type": "object",
                    "required": ["timezone", "language", "notification_channels"],
                    "properties": {
                      "timezone": { "type": "string" },
                      "language": {
                        "type": "string",
                        "enum": ["en", "es"]
                      },
                      "notification_channels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["email", "sms", "whatsapp", "push"]
                        }
                      }
                    }
                  }
                }
              },
              "organization_context": {
                "type": "object",
                "required": ["organization_id", "organization_name", "role"],
                "properties": {
                  "organization_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Organization identifier"
                  },
                  "organization_name": {
                    "type": "string",
                    "description": "Organization name"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["admin", "staff", "viewer"],
                    "description": "Staff role in organization"
                  },
                  "permissions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Granted permissions"
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "notification_policy": {
                        "type": "object",
                        "properties": {
                          "require_approval": {
                            "type": "boolean",
                            "default": false
                          },
                          "allowed_channels": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": ["email", "sms", "whatsapp", "push"]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "added_by_user": {
                "type": "object",
                "required": ["user_id", "display_name"],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "description": "User who added the staff member"
                  },
                  "display_name": {
                    "type": "string",
                    "description": "Display name of user who added staff"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["admin", "staff", "viewer"],
                    "description": "Role of user who added staff"
                  }
                }
              },
              "welcome_message": {
                "type": "string",
                "description": "Custom welcome message",
                "nullable": true
              },
              "onboarding_requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["verify_email", "verify_phone", "complete_profile", "review_policies"]
                },
                "description": "Required onboarding steps for new staff member"
              }
            }
          }
        }
      }
    ]
  },
  "CommunicationOptIn": {
    "allOf": [
      { "$ref": "#/definitions/UserEvent" },
      {
        "properties": {
          "event_type": {
            "const": "communication.opt_in"
          },
          "data": {
            "type": "object",
            "required": ["user_id", "channels"],
            "properties": {
              "user_id": {
                "type": "string",
                "description": "User identifier"
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["email", "sms", "whatsapp", "push"]
                },
                "description": "Communication channels opted into"
              },
              "preferences": {
                "type": "object",
                "properties": {
                  "frequency": {
                    "type": "string",
                    "enum": ["immediate", "daily_digest", "weekly_digest"],
                    "description": "Notification frequency preference"
                  },
                  "quiet_hours": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "string",
                        "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
                        "description": "Quiet hours start time (HH:MM)"
                      },
                      "end": {
                        "type": "string",
                        "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
                        "description": "Quiet hours end time (HH:MM)"
                      }
                    }
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["post_created", "post_matched", "post_claimed", "post_resolved", "system_updates"]
                    },
                    "description": "Notification categories opted into"
                  }
                }
              },
              "opt_in_source": {
                "type": "string",
                "enum": ["registration", "settings", "prompt", "api"],
                "description": "How the user opted in"
              },
              "legal_basis": {
                "type": "string",
                "enum": ["consent", "legitimate_interest", "contract"],
                "description": "Legal basis for communication (GDPR compliance)"
              }
            }
          }
        }
      }
    ]
  },
  "UserUpdated": {
    "allOf": [
      { "$ref": "#/definitions/UserEvent" },
      {
        "properties": {
          "event_type": {
            "const": "user.updated"
          },
          "data": {
            "type": "object",
            "required": ["user", "changed_fields"],
            "properties": {
              "user": {
                "$ref": "../../shared/domains.json#/definitions/PrivacySafeUser"
              },
              "changed_fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["display_name", "avatar_url", "timezone", "language", "organization_memberships", "preferences"]
                },
                "description": "List of fields that were updated (no PII fields allowed)"
              },
              "update_source": {
                "type": "string",
                "enum": ["user_profile", "admin_action", "system_sync", "organization_change"],
                "description": "Source of the update"
              },
              "preferences_changes": {
                "type": "object",
                "properties": {
                  "notification_settings": {
                    "type": "object",
                    "properties": {
                      "channels_added": {
                        "type": "array",
                        "items": { "type": "string", "enum": ["email", "sms", "whatsapp", "push"] }
                      },
                      "channels_removed": {
                        "type": "array",
                        "items": { "type": "string", "enum": ["email", "sms", "whatsapp", "push"] }
                      },
                      "frequency_changed": {
                        "type": "object",
                        "properties": {
                          "from": { "type": "string", "enum": ["immediate", "daily_digest", "weekly_digest"] },
                          "to": { "type": "string", "enum": ["immediate", "daily_digest", "weekly_digest"] }
                        }
                      }
                    }
                  },
                  "locale_changes": {
                    "type": "object",
                    "properties": {
                      "timezone_changed": {
                        "type": "object",
                        "properties": {
                          "from": { "type": "string" },
                          "to": { "type": "string" }
                        }
                      },
                      "language_changed": {
                        "type": "object",
                        "properties": {
                          "from": { "type": "string", "enum": ["en", "es"] },
                          "to": { "type": "string", "enum": ["en", "es"] }
                        }
                      }
                    }
                  }
                },
                "description": "Detailed information about preference changes"
              },
              "organization_changes": {
                "type": "object",
                "properties": {
                  "memberships_added": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "organization_id": { "type": "string", "format": "uuid" },
                        "organization_name": { "type": "string" },
                        "role": { "type": "string", "enum": ["admin", "staff", "viewer"] }
                      }
                    }
                  },
                  "memberships_removed": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "organization_id": { "type": "string", "format": "uuid" },
                        "organization_name": { "type": "string" },
                        "role": { "type": "string", "enum": ["admin", "staff", "viewer"] }
                      }
                    }
                  },
                  "role_changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "organization_id": { "type": "string", "format": "uuid" },
                        "organization_name": { "type": "string" },
                        "from_role": { "type": "string", "enum": ["admin", "staff", "viewer"] },
                        "to_role": { "type": "string", "enum": ["admin", "staff", "viewer"] }
                      }
                    }
                  }
                },
                "description": "Organization membership changes"
              },
              "update_metadata": {
                "type": "object",
                "properties": {
                  "updated_by": {
                    "type": "object",
                    "properties": {
                      "user_id": { "type": "string" },
                      "role": { "type": "string" },
                      "source": { "type": "string", "enum": ["self", "admin", "system"] }
                    }
                  },
                  "reason": {
                    "type": "string",
                    "description": "Reason for the update"
                  },
                  "ip_country": {
                    "type": "string",
                    "description": "Country from which update was made (for security)"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}