{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://findlynow.com/schemas/user-events.json",
  "title": "User Events Schema",
  "description": "Event schemas for user registration, organization management, and communication preferences",
  "definitions": {
    "BaseEvent": {
      "type": "object",
      "required": ["id", "event_type", "timestamp", "version"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique event identifier"
        },
        "event_type": {
          "type": "string",
          "description": "Type of event"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Event occurrence timestamp"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Event schema version"
        }
      }
    },
    "UserEvent": {
      "allOf": [
        { "$ref": "#/definitions/BaseEvent" },
        {
          "type": "object",
          "required": ["user_id", "data"],
          "properties": {
            "user_id": {
              "type": "string",
              "description": "User identifier"
            },
            "organization_id": {
              "type": "string",
              "format": "uuid",
              "description": "Organization identifier (for multi-tenant)",
              "nullable": true
            },
            "data": {
              "type": "object",
              "description": "Event-specific data"
            }
          }
        }
      ]
    }
  },
  "UserRegistered": {
    "allOf": [
      { "$ref": "#/definitions/UserEvent" },
      {
        "properties": {
          "event_type": {
            "const": "user.registered"
          },
          "data": {
            "type": "object",
            "required": ["user_id"],
            "properties": {
              "user_id": {
                "type": "string",
                "description": "Unique user identifier"
              },
              "name": {
                "type": "string",
                "description": "User's full name"
              },
              "user_name": {
                "type": "string",
                "description": "Alternative field name for user's name"
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "User's email address"
              },
              "phone": {
                "type": "string",
                "description": "User's phone number"
              },
              "registration_source": {
                "type": "string",
                "enum": ["web", "mobile", "api"],
                "description": "Source of registration"
              },
              "profile": {
                "type": "object",
                "properties": {
                  "avatar_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "User's avatar image URL"
                  },
                  "timezone": {
                    "type": "string",
                    "description": "User's timezone"
                  },
                  "language": {
                    "type": "string",
                    "enum": ["en", "es"],
                    "description": "Preferred language"
                  }
                }
              },
              "preferences": {
                "type": "object",
                "properties": {
                  "email_notifications": {
                    "type": "boolean",
                    "default": true,
                    "description": "Email notification preference"
                  },
                  "sms_notifications": {
                    "type": "boolean",
                    "default": false,
                    "description": "SMS notification preference"
                  },
                  "whatsapp_notifications": {
                    "type": "boolean",
                    "default": false,
                    "description": "WhatsApp notification preference"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "StaffAdded": {
    "allOf": [
      { "$ref": "#/definitions/UserEvent" },
      {
        "properties": {
          "event_type": {
            "const": "organization.staff_added"
          },
          "data": {
            "type": "object",
            "required": ["user_id", "organization_id", "organization_name"],
            "properties": {
              "user_id": {
                "type": "string",
                "description": "Staff member user ID"
              },
              "organization_id": {
                "type": "string",
                "format": "uuid",
                "description": "Organization identifier"
              },
              "organization_name": {
                "type": "string",
                "description": "Organization name"
              },
              "role": {
                "type": "string",
                "enum": ["admin", "staff", "viewer"],
                "description": "Staff role in organization"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Granted permissions"
              },
              "added_by": {
                "type": "string",
                "description": "User who added the staff member"
              },
              "welcome_message": {
                "type": "string",
                "description": "Custom welcome message"
              }
            }
          }
        }
      }
    ]
  },
  "CommunicationOptIn": {
    "allOf": [
      { "$ref": "#/definitions/UserEvent" },
      {
        "properties": {
          "event_type": {
            "const": "communication.opt_in"
          },
          "data": {
            "type": "object",
            "required": ["user_id", "channels"],
            "properties": {
              "user_id": {
                "type": "string",
                "description": "User identifier"
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["email", "sms", "whatsapp", "push"]
                },
                "description": "Communication channels opted into"
              },
              "preferences": {
                "type": "object",
                "properties": {
                  "frequency": {
                    "type": "string",
                    "enum": ["immediate", "daily_digest", "weekly_digest"],
                    "description": "Notification frequency preference"
                  },
                  "quiet_hours": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "string",
                        "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
                        "description": "Quiet hours start time (HH:MM)"
                      },
                      "end": {
                        "type": "string",
                        "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
                        "description": "Quiet hours end time (HH:MM)"
                      }
                    }
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["post_created", "post_matched", "post_claimed", "post_resolved", "system_updates"]
                    },
                    "description": "Notification categories opted into"
                  }
                }
              },
              "opt_in_source": {
                "type": "string",
                "enum": ["registration", "settings", "prompt", "api"],
                "description": "How the user opted in"
              },
              "legal_basis": {
                "type": "string",
                "enum": ["consent", "legitimate_interest", "contract"],
                "description": "Legal basis for communication (GDPR compliance)"
              }
            }
          }
        }
      }
    ]
  }
}