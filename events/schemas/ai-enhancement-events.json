{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://findlynow.com/schemas/ai-enhancement-events.json",
  "title": "AI Enhancement Events Schema",
  "description": "Event schemas for AI-enhanced posts and photo processing in the Lost & Found platform",
  "definitions": {
    "BaseEvent": {
      "type": "object",
      "required": ["id", "event_type", "timestamp", "version"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique event identifier"
        },
        "event_type": {
          "type": "string",
          "description": "Type of event"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Event occurrence timestamp"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Event schema version"
        }
      }
    },
    "EnhancedMetadata": {
      "type": "object",
      "required": ["tags", "attributes", "enhancement_summary"],
      "properties": {
        "enhanced_description": {
          "type": "string",
          "description": "AI-generated enhanced description",
          "nullable": true
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "../../shared/ai-metadata.json#/definitions/AITag"
          },
          "description": "AI-extracted tags with confidence and source tracking"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "objects": {
              "type": "array",
              "items": {
                "$ref": "../../shared/ai-metadata.json#/definitions/DetectedObject"
              }
            },
            "colors": {
              "type": "array",
              "items": {
                "$ref": "../../shared/ai-metadata.json#/definitions/ColorAnalysis"
              }
            },
            "scene": {
              "$ref": "../../shared/ai-metadata.json#/definitions/SceneAnalysis",
              "nullable": true
            },
            "text_content": {
              "type": "array",
              "items": {
                "$ref": "../../shared/ai-metadata.json#/definitions/ExtractedText"
              }
            }
          }
        },
        "location_inference": {
          "$ref": "../../shared/ai-metadata.json#/definitions/LocationInference",
          "nullable": true
        },
        "enhancement_summary": {
          "type": "object",
          "required": ["changes_made", "improvement_areas"],
          "properties": {
            "changes_made": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["added_tags", "enhanced_description", "detected_objects", "extracted_text", "inferred_location", "color_analysis"]
              }
            },
            "improvement_areas": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["searchability", "matchability", "description_quality", "location_accuracy", "categorization"]
              }
            },
            "quality_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall enhancement quality score"
            }
          }
        }
      }
    },
    "DownstreamActions": {
      "type": "object",
      "properties": {
        "reindex_required": {
          "type": "boolean",
          "default": true,
          "description": "Whether search index needs updating"
        },
        "matching_update_required": {
          "type": "boolean",
          "default": true,
          "description": "Whether matching algorithms should re-evaluate"
        },
        "notification_policy": {
          "type": "object",
          "properties": {
            "notify_user": {
              "type": "boolean",
              "description": "Whether to notify user of enhancement"
            },
            "significant_changes": {
              "type": "array",
              "items": { "type": "string" },
              "description": "List of significant changes to highlight"
            }
          }
        }
      },
      "description": "Actions required by downstream services"
    }
  },
  "PostEnhanced": {
    "allOf": [
      { "$ref": "#/definitions/BaseEvent" },
      {
        "properties": {
          "event_type": {
            "const": "post.enhanced"
          },
          "data": {
            "type": "object",
            "required": ["original_post", "post_owner", "enhanced_metadata", "ai_analysis"],
            "properties": {
              "original_post": {
                "$ref": "../post-events.json#/definitions/Post",
                "description": "Complete original post data before enhancement"
              },
              "post_owner": {
                "$ref": "../../shared/domains.json#/definitions/PrivacySafeUserExtended"
              },
              "organization": {
                "$ref": "../../shared/domains.json#/definitions/OrganizationData",
                "nullable": true
              },
              "enhanced_metadata": {
                "$ref": "#/definitions/EnhancedMetadata"
              },
              "ai_analysis": {
                "$ref": "../../shared/ai-metadata.json#/definitions/AIMetadata"
              },
              "downstream_actions": {
                "$ref": "#/definitions/DownstreamActions",
                "nullable": true
              }
            }
          }
        }
      }
    ]
  },
  "PhotoProcessed": {
    "allOf": [
      { "$ref": "#/definitions/BaseEvent" },
      {
        "properties": {
          "event_type": {
            "const": "photo.processed"
          },
          "data": {
            "type": "object",
            "required": ["photo_id", "post_id", "processing_results", "post_owner"],
            "properties": {
              "photo_id": {
                "type": "string",
                "format": "uuid",
                "description": "Photo identifier"
              },
              "post_id": {
                "type": "string",
                "format": "uuid",
                "description": "Associated post identifier"
              },
              "post_owner": {
                "$ref": "../../shared/domains.json#/definitions/PrivacySafeUserExtended"
              },
              "processing_results": {
                "type": "object",
                "required": ["status", "processed_at"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["success", "failed", "partial"],
                    "description": "Processing status"
                  },
                  "processed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When processing completed"
                  },
                  "ai_metadata": {
                    "$ref": "../../shared/ai-metadata.json#/definitions/AIMetadata",
                    "nullable": true
                  },
                  "generated_thumbnails": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "size": { "type": "string", "enum": ["small", "medium", "large"] },
                        "url": { "type": "string", "format": "uri" },
                        "dimensions": {
                          "type": "object",
                          "properties": {
                            "width": { "type": "integer" },
                            "height": { "type": "integer" }
                          }
                        }
                      }
                    }
                  },
                  "processing_time_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Time taken for processing in milliseconds"
                  },
                  "error_details": {
                    "type": "object",
                    "properties": {
                      "error_code": { "type": "string" },
                      "error_message": { "type": "string" },
                      "retry_count": { "type": "integer", "minimum": 0 }
                    },
                    "nullable": true
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}