{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://findlynow.com/schemas/contact-exchange-events.json",
  "title": "Contact Exchange Events Schema",
  "description": "Event schemas for secure contact exchange workflow in the Lost & Found platform - PRIVACY-FIRST: NO PII IN EVENTS",
  "definitions": {
    "BaseEvent": {
      "type": "object",
      "required": ["id", "event_type", "timestamp", "version"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique event identifier"
        },
        "event_type": {
          "type": "string",
          "description": "Type of event"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Event occurrence timestamp"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Event schema version"
        }
      }
    }
  },
  "ContactExchangeRequested": {
    "allOf": [
      { "$ref": "#/definitions/BaseEvent" },
      {
        "properties": {
          "event_type": {
            "const": "contact.exchange.requested"
          },
          "data": {
            "type": "object",
            "required": ["contact_request", "related_post", "requester", "owner"],
            "properties": {
              "contact_request": {
                "type": "object",
                "required": ["request_id", "status", "expires_at", "created_at"],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Unique contact exchange request identifier"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["pending"],
                    "description": "Initial status is always pending"
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "Message from requester",
                    "nullable": true
                  },
                  "verification_required": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether additional verification is required"
                  },
                  "verification_details": {
                    "type": "object",
                    "properties": {
                      "method": {
                        "type": "string",
                        "enum": ["photo_proof", "security_question", "admin_approval"],
                        "description": "Required verification method"
                      },
                      "question": {
                        "type": "string",
                        "description": "Security question if applicable"
                      },
                      "requirements": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "List of verification requirements"
                      }
                    },
                    "nullable": true
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the request expires"
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the request was created"
                  }
                }
              },
              "related_post": {
                "type": "object",
                "required": ["id", "title", "type", "status"],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Post identifier"
                  },
                  "title": {
                    "type": "string",
                    "description": "Post title"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["lost", "found"]
                  },
                  "status": {
                    "type": "string",
                    "enum": ["active", "resolved", "expired", "deleted"]
                  },
                  "location": {
                    "type": "object",
                    "properties": {
                      "latitude": { "type": "number" },
                      "longitude": { "type": "number" },
                      "address": { "type": "string", "nullable": true }
                    }
                  }
                }
              },
              "requester": {
                "allOf": [
                  { "$ref": "../../shared/domains.json#/definitions/PrivacySafeUserExtended" },
                  {
                    "type": "object",
                    "properties": {
                      "reputation_score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5,
                        "description": "User reputation score for trust assessment"
                      },
                      "verification_level": {
                        "type": "string",
                        "enum": ["unverified", "email_verified", "phone_verified", "fully_verified"],
                        "description": "User verification level"
                      }
                    }
                  }
                ]
              },
              "owner": {
                "allOf": [
                  { "$ref": "../../shared/domains.json#/definitions/PrivacySafeUserExtended" },
                  {
                    "type": "object",
                    "properties": {
                      "contact_sharing_policy": {
                        "type": "object",
                        "properties": {
                          "auto_approve_verified": { "type": "boolean", "default": false },
                          "require_verification": { "type": "boolean", "default": true },
                          "preferred_contact_method": {
                            "type": "string",
                            "enum": ["email", "phone", "platform"]
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "notification_requirements": {
                "type": "object",
                "properties": {
                  "immediate_notification": {
                    "type": "boolean",
                    "default": true
                  },
                  "notification_template": {
                    "type": "string",
                    "description": "Template to use for owner notification"
                  },
                  "reminder_schedule": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "delay_hours": { "type": "integer", "minimum": 1 },
                        "template": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "ContactExchangeApproved": {
    "allOf": [
      { "$ref": "#/definitions/BaseEvent" },
      {
        "properties": {
          "event_type": {
            "const": "contact.exchange.approved"
          },
          "data": {
            "type": "object",
            "required": ["contact_approval", "related_post", "requester", "owner"],
            "properties": {
              "contact_approval": {
                "type": "object",
                "required": ["request_id", "approval_type", "approved_at"],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Reference to original contact exchange request"
                  },
                  "approval_type": {
                    "type": "string",
                    "enum": ["full_contact", "platform_message", "limited_contact"],
                    "description": "Type of contact sharing approved"
                  },
                  "contact_token": {
                    "$ref": "../../shared/domains.json#/definitions/ContactExchangeToken",
                    "description": "Secure token containing encrypted contact information - NO PII IN EVENT"
                  },
                  "preferred_method": {
                    "type": "string",
                    "enum": ["email", "phone", "platform"],
                    "description": "Owner's preferred contact method (no actual contact info)"
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "Message from owner",
                    "nullable": true
                  },
                  "sharing_restrictions": {
                    "type": "object",
                    "properties": {
                      "expires_after_hours": { "type": "integer", "minimum": 1 },
                      "single_use": { "type": "boolean", "default": false },
                      "platform_mediated": { "type": "boolean", "default": false }
                    }
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the shared contact expires"
                  },
                  "approved_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When approval was granted"
                  },
                  "verification_completed": {
                    "type": "boolean",
                    "description": "Whether required verification was completed"
                  }
                }
              },
              "related_post": {
                "type": "object",
                "required": ["id", "title", "type", "status"],
                "properties": {
                  "id": { "type": "string", "format": "uuid" },
                  "title": { "type": "string" },
                  "type": { "type": "string", "enum": ["lost", "found"] },
                  "status": { "type": "string", "enum": ["active", "resolved", "expired", "deleted"] }
                }
              },
              "requester": {
                "$ref": "../../shared/domains.json#/definitions/PrivacySafeUserExtended"
              },
              "owner": {
                "$ref": "../../shared/domains.json#/definitions/PrivacySafeUserExtended"
              },
              "notification_requirements": {
                "type": "object",
                "properties": {
                  "notify_requester": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to notify requester of approval"
                  },
                  "notification_template": {
                    "type": "string",
                    "description": "Template for requester notification"
                  },
                  "include_contact_instructions": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to include contact instructions"
                  }
                }
              },
              "audit_trail": {
                "type": "object",
                "properties": {
                  "approval_source": {
                    "type": "string",
                    "enum": ["manual", "automatic", "admin_override"],
                    "description": "How the approval was granted"
                  },
                  "approval_criteria_met": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of criteria that were met for approval"
                  },
                  "risk_assessment": {
                    "type": "object",
                    "properties": {
                      "risk_level": {
                        "type": "string",
                        "enum": ["low", "medium", "high"]
                      },
                      "risk_factors": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "ContactExchangeDenied": {
    "allOf": [
      { "$ref": "#/definitions/BaseEvent" },
      {
        "properties": {
          "event_type": {
            "const": "contact.exchange.denied"
          },
          "data": {
            "type": "object",
            "required": ["contact_denial", "related_post", "requester", "owner"],
            "properties": {
              "contact_denial": {
                "type": "object",
                "required": ["request_id", "denial_reason", "denied_at"],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Reference to original contact exchange request"
                  },
                  "denial_reason": {
                    "type": "string",
                    "enum": ["not_owner", "insufficient_verification", "suspicious_request", "post_resolved", "user_preference", "other"],
                    "description": "Reason for denial"
                  },
                  "denial_message": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "Optional message from owner",
                    "nullable": true
                  },
                  "denied_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When denial was recorded"
                  },
                  "denial_source": {
                    "type": "string",
                    "enum": ["manual", "automatic", "timeout", "admin_action"],
                    "description": "How the denial occurred"
                  }
                }
              },
              "related_post": {
                "type": "object",
                "required": ["id", "title", "type"],
                "properties": {
                  "id": { "type": "string", "format": "uuid" },
                  "title": { "type": "string" },
                  "type": { "type": "string", "enum": ["lost", "found"] }
                }
              },
              "requester": {
                "$ref": "../../shared/domains.json#/definitions/PrivacySafeUserExtended"
              },
              "owner": {
                "$ref": "../../shared/domains.json#/definitions/PrivacySafeUserExtended"
              },
              "notification_requirements": {
                "type": "object",
                "properties": {
                  "notify_requester": {
                    "type": "boolean",
                    "default": true
                  },
                  "include_alternative_actions": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to suggest alternative actions to requester"
                  },
                  "notification_template": {
                    "type": "string",
                    "description": "Template for denial notification"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "ContactExchangeExpired": {
    "allOf": [
      { "$ref": "#/definitions/BaseEvent" },
      {
        "properties": {
          "event_type": {
            "const": "contact.exchange.expired"
          },
          "data": {
            "type": "object",
            "required": ["contact_expiration", "related_post", "involved_users"],
            "properties": {
              "contact_expiration": {
                "type": "object",
                "required": ["request_id", "expiration_reason", "expired_at"],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Contact exchange request that expired"
                  },
                  "original_status": {
                    "type": "string",
                    "enum": ["pending", "approved"],
                    "description": "Status before expiration"
                  },
                  "expiration_reason": {
                    "type": "string",
                    "enum": ["timeout", "no_response", "contact_used", "system_cleanup", "user_revoked"],
                    "description": "Why the exchange expired"
                  },
                  "expired_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When expiration occurred"
                  },
                  "duration_hours": {
                    "type": "number",
                    "minimum": 0,
                    "description": "How long the request/approval was active"
                  }
                }
              },
              "related_post": {
                "type": "object",
                "required": ["id", "title", "type"],
                "properties": {
                  "id": { "type": "string", "format": "uuid" },
                  "title": { "type": "string" },
                  "type": { "type": "string", "enum": ["lost", "found"] }
                }
              },
              "involved_users": {
                "type": "object",
                "required": ["requester", "owner"],
                "properties": {
                  "requester": {
                    "$ref": "../../shared/domains.json#/definitions/PrivacySafeUserExtended"
                  },
                  "owner": {
                    "$ref": "../../shared/domains.json#/definitions/PrivacySafeUserExtended"
                  }
                }
              },
              "cleanup_actions": {
                "type": "object",
                "properties": {
                  "revoke_contact_access": {
                    "type": "boolean",
                    "default": true
                  },
                  "archive_request_data": {
                    "type": "boolean",
                    "default": true
                  },
                  "update_analytics": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}